        | (Node rrl1 x xa) → Node (Node (Node l b rl) c rrl1) x xa

delete : (a : a, t : Tree a) | pot(t) + 5/2 * log(|t|) → (y : Tree a) | pot(y)
delete a t = match ~ splay a t with
  | Leaf -> Leaf
  | (Node l b r) -> if a == b
    then match l with
      | Leaf → r
      | l    → match ~ splay_max l with
        | Leaf -> Leaf
        | (Node ll m d) → Node ll m r
    else Node l b r
