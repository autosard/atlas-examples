{-# TEMPLATE [nlog, log(1,2), pot] #-}

import SearchTree.Splay
import Data.List

-- slightly better bound: (|l| - 1) * 2 * log(|l| + 1) = 2 * |l| * log(|l| + 1) - 2 log(|l| + 1)
fromList : (l : List a) | 2 * |l| * log(|l|) -> (y : Tree a) | pot(y)
fromList Nil = Leaf
fromList (Cons x xs) = insert x (fromList xs)
